{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Go Renovate configuration for Go modules, tools, and dependencies",
  "extends": ["github>sbaerlocher/.github:renovate-base#main"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Go version updates - higher stability",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": "Go version",
      "semanticCommitScope": "go",
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "labels": ["go", "golang-version"],
      "prPriority": 20
    },
    {
      "description": "Go ecosystem packages - golang.org/x, go.uber.org",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**", "go.uber.org/**"],
      "groupName": "Go ecosystem packages",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Go platform packages - gRPC, Kubernetes, Prometheus",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "google.golang.org/**",
        "github.com/grpc-ecosystem/**",
        "k8s.io/**",
        "sigs.k8s.io/**",
        "github.com/prometheus/**"
      ],
      "groupName": "Go platform packages",
      "semanticCommitScope": "platform",
      "minimumReleaseAge": "7 days",
      "labels": ["platform"]
    },
    {
      "description": "Go dev tooling - testing, linting, build tools",
      "matchManagers": ["gomod"],
      "groupName": "Go dev tooling",
      "semanticCommitScope": "tools",
      "labels": ["dev-tools"],
      "matchPackageNames": [
        "/testify/",
        "/gomock/",
        "/mockery/",
        "/ginkgo/",
        "/gomega/",
        "/golangci-lint/",
        "/gofumpt/",
        "/goimports/",
        "/staticcheck/",
        "/air/",
        "/wire/",
        "/mockgen/",
        "/protoc-gen/",
        "/buf/",
        "/goreleaser/"
      ]
    },
    {
      "description": "Major golang.org/x updates - auto-approve (pseudo-versioned)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "minimumReleaseAge": "5 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go version in .go-version files",
      "managerFilePatterns": ["/(^|/)\\.go-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)$"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Go version in Makefiles",
      "managerFilePatterns": ["/^Makefile$/", "/\\.mk$/"],
      "matchStrings": ["GO_VERSION\\s*[:?]?=\\s*(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)"],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Go tools in Makefiles",
      "managerFilePatterns": ["/^Makefile$/", "/\\.mk$/"],
      "matchStrings": ["GOLANGCI_LINT_VERSION\\s*[:?]?=\\s*v?(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Go tools versions in comments",
      "managerFilePatterns": ["/\\.ya?ml$/", "/Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*go-tool\\s+(?<depName>[^\\s]+)\\s+(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
