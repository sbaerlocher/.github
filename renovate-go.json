{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Go Renovate configuration for Go modules, tools, and dependencies",
  "extends": ["github>sbaerlocher/.github:renovate-base#main"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Go version updates - higher stability",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "groupName": "Go version",
      "semanticCommitScope": "go",
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "labels": ["go", "golang-version"],
      "prPriority": 20
    },
    {
      "description": "Go ecosystem packages - golang.org/x, go.uber.org",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**", "go.uber.org/**"],
      "groupName": "Go ecosystem packages",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Go platform packages - gRPC, Kubernetes, Prometheus. separateMultipleMajor: false so co-dependent k8s.io/* + sigs.k8s.io/* majors share one branch/PR.",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "google.golang.org/**",
        "github.com/grpc-ecosystem/**",
        "k8s.io/**",
        "sigs.k8s.io/**",
        "github.com/prometheus/**"
      ],
      "groupName": "Go platform packages",
      "semanticCommitScope": "platform",
      "minimumReleaseAge": "7 days",
      "labels": ["platform"],
      "separateMultipleMajor": false
    },
    {
      "description": "Go dev tooling - testing, linting, build tools",
      "matchManagers": ["gomod"],
      "groupName": "Go dev tooling",
      "semanticCommitScope": "tools",
      "labels": ["dev-tools"],
      "matchPackageNames": [
        "/testify/",
        "/gomock/",
        "/mockery/",
        "/ginkgo/",
        "/gomega/",
        "/golangci-lint/",
        "/gofumpt/",
        "/goimports/",
        "/staticcheck/",
        "/air/",
        "/wire/",
        "/mockgen/",
        "/protoc-gen/",
        "/buf/",
        "/goreleaser/"
      ]
    },
    {
      "description": "Major golang.org/x updates - auto-approve (pseudo-versioned)",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["golang.org/x/**"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "minimumReleaseAge": "5 days"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Go tools installed via 'RUN go install <module>@<version>' in Dockerfiles. Version lives on the RUN line (single source of truth); the preceding '# renovate: datasource=... depName=...' comment tags the line for Renovate.",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(\\s+versioning=(?<versioning>[^\\s]+))?(\\s+extractVersion=(?<extractVersion>[^\\s]+))?\\s+RUN\\s+go\\s+install\\s+\\S+@(?<currentValue>[^\\s]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
