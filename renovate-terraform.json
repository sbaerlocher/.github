{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Terraform/IaC Renovate configuration for providers, modules, and tools",
  "extends": ["github>sbaerlocher/.github:renovate-base#main"],
  "enabledManagers": [
    "terraform",
    "terraform-version",
    "tflint-plugin",
    "github-actions",
    "custom.regex"
  ],
  "terraform": {
    "managerFilePatterns": ["/\\.tf$/", "/(^|/)\\.terraform\\.lock\\.hcl$/"]
  },
  "packageRules": [
    {
      "description": "Pin the terraform-provider datasource to registry.terraform.io only. By default Renovate queries [registry.terraform.io, releases.hashicorp.com]; the latter times out / 403s on Mend's hosted runner (and is being deprecated for partner/3rd-party providers in favour of release-assets.githubusercontent.com), causing persistent 'no-result' dashboard warnings. Overriding registryUrls drops the broken backend while keeping native range handling intact (see renovate terraform-provider datasource: hashicorpReleaseUrl is only queried when present in registryUrls).",
      "matchDatasources": ["terraform-provider"],
      "registryUrls": ["https://registry.terraform.io"]
    },
    {
      "description": "Terraform Core version updates - higher stability",
      "matchManagers": ["terraform-version"],
      "matchPackageNames": ["hashicorp/terraform"],
      "groupName": "Terraform Core",
      "semanticCommitScope": "terraform",
      "minimumReleaseAge": "14 days",
      "automerge": false,
      "labels": ["terraform-core"],
      "prPriority": 20
    },
    {
      "description": "Group Terraform Providers by patch/minor",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Terraform Providers (non-major)",
      "semanticCommitScope": "providers",
      "minimumReleaseAge": "5 days",
      "labels": ["terraform", "providers"]
    },
    {
      "description": "Terraform Provider major updates - individual PRs",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "matchUpdateTypes": ["major"],
      "groupName": null,
      "minimumReleaseAge": "14 days",
      "labels": ["terraform", "providers", "major-update"],
      "semanticCommitType": "feat",
      "semanticCommitScope": "providers"
    },
    {
      "description": "Critical providers - extra stability",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-provider"],
      "matchPackageNames": [
        "hashicorp/aws",
        "hashicorp/azurerm",
        "hashicorp/google",
        "hetznercloud/hcloud",
        "cloudflare/cloudflare",
        "integrations/github"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": false,
      "prPriority": 5,
      "labels": ["terraform", "critical-provider"]
    },
    {
      "description": "Terraform Modules updates",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-module", "github-tags", "git-tags"],
      "groupName": "Terraform Modules",
      "semanticCommitScope": "modules",
      "minimumReleaseAge": "7 days",
      "labels": ["terraform", "modules"]
    },
    {
      "description": "Terraform Module major updates - higher stability",
      "matchManagers": ["terraform"],
      "matchDatasources": ["terraform-module", "github-tags", "git-tags"],
      "matchUpdateTypes": ["major"],
      "minimumReleaseAge": "14 days",
      "labels": ["terraform", "modules", "major-update"]
    },
    {
      "description": "tflint and plugins",
      "matchManagers": ["tflint-plugin"],
      "groupName": "tflint",
      "semanticCommitScope": "lint",
      "labels": ["terraform", "tflint"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Terraform version in .terraform-version files",
      "managerFilePatterns": ["/(^|/)\\.terraform-version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/terraform",
      "versioningTemplate": "hashicorp"
    },
    {
      "customType": "regex",
      "description": "Terraform version in Makefiles",
      "managerFilePatterns": ["/^Makefile$/", "/\\.mk$/"],
      "matchStrings": ["TERRAFORM_VERSION\\s*[:?]?=\\s*(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/terraform",
      "versioningTemplate": "hashicorp"
    },
    {
      "customType": "regex",
      "description": "Terraform provider versions in comments",
      "managerFilePatterns": ["/\\.tf$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*terraform-provider\\s+(?<depName>[^\\s]+)\\s+(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "terraform-provider",
      "versioningTemplate": "hashicorp"
    },
    {
      "customType": "regex",
      "description": "Ansible versions in requirements files",
      "managerFilePatterns": ["/^ansible/requirements\\.ya?ml$/", "/requirements\\.ya?ml$/"],
      "matchStrings": [
        "version:\\s+['\"]?(?<currentValue>[^'\"\\s]+)['\"]?\\s+#\\s*renovate:\\s*(?<depName>[^\\s]+)"
      ],
      "datasourceTemplate": "galaxy-collection",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Packer version in .packer-version files",
      "managerFilePatterns": ["/(^|/)\\.packer-version$/"],
      "matchStrings": ["^(?<currentValue>\\S+)$"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/packer",
      "versioningTemplate": "hashicorp"
    }
  ],
  "hostRules": [
    {
      "description": "Terraform Registry",
      "hostType": "terraform-provider",
      "timeout": 30000
    },
    {
      "description": "Terraform Module Registry",
      "hostType": "terraform-module",
      "timeout": 30000
    }
  ]
}
